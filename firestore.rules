rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTransaction(data) {
      return data.userId is string && data.userId == request.auth.uid
        && (data.context == 'personal' || data.context == 'business')
        && (data.type == 'income' || data.type == 'expense')
        && data.amount is number && data.amount > 0
        && data.category is string && data.category.size() > 0 && data.category.size() <= 64
        && data.description is string && data.description.size() <= 160
        && data.date is string && data.date.size() <= 30
        && (data.status == 'paid' || data.status == 'pending')
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 30))
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 100))
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10))
        && (!('notificationsEnabled' in data) || (data.notificationsEnabled is bool))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Rules for Transactions collection
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && isValidId(transactionId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidId(transactionId) 
        && isValidTransaction(incoming()) 
        && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() 
        && isValidId(transactionId) 
        && existing().userId == request.auth.uid 
        && isValidTransaction(incoming()) 
        && incoming().userId == existing().userId;
      allow delete: if isSignedIn() 
        && isValidId(transactionId) 
        && existing().userId == request.auth.uid;
    }

    // Rules for Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create, update: if isSignedIn() 
        && isValidId(userId) 
        && request.auth.uid == userId 
        && isValidUserProfile(incoming()) 
        && incoming().userId == request.auth.uid;
      allow delete: if false;
    }

    // Diagnostics / health check
    match /test/{docId} {
      allow get: if true;
    }
  }
}
